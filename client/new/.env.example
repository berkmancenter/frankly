# App Branding and URLs 
VITE_APP_NAME=Frankly
VITE_APP_URL=https://app.frankly.org
VITE_TERMS_URL=https://frankly.org/terms
VITE_PRICING_URL=https://frankly.org/pricing
VITE_ABOUT_URL=https://frankly.org
VITE_PRIVACY_POLICY_URL=https://frankly.org/privacy
VITE_SUPPORT_EMAIL=support@frankly.org
VITE_HELP_CENTER_URL=https://rebootingsocialmedia.notion.site/Frankly-Help-Center-23b4f9a120a344d4af2b2ce44b2ae229
VITE_HELP_CENTER_MANAGING_COMMUNITY_URL=https://rebootingsocialmedia.notion.site/Managing-your-Community-d29e7832b9434cc7981d420d62730043
VITE_CREATE_TEMPLATE_HELP_URL=https://rebootingsocialmedia.notion.site/Creating-and-Managing-Events-552a42e4a09549b788e1901536a25965
VITE_CREATE_EVENT_HELP_URL=https://rebootingsocialmedia.notion.site/Creating-and-Managing-Events-552a42e4a09549b788e1901536a25965
VITE_TROUBLESHOOTING_GUIDE_URL=https://rebootingsocialmedia.notion.site/Troubleshooting-c6f922b816a742a9bba4bf000e84565d
VITE_LOGO_URL=https://res.cloudinary.com/dh0vegjku/image/upload/v1725488238/frankly_assets/Frankly-Icon-144x144_ex8nky.png
VITE_SIDEBAR_FOOTER='Frankly is operated by the Applied Social Media Lab at the Berkman Klein Center for Internet & Society'
VITE_COPYRIGHT_STATEMENT='© 2026 President and Fellows of Harvard College.'
VITE_SHARE_LINK_URL=<value>
VITE_REPO_LINK_URL=<value>

# Firebase web app configuration (use the same project as the Flutter client).
# Local emulator mode defaults to project "dev" and does not require these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Use the local Firebase Auth, Firestore, and Functions emulators.
# Local development defaults to emulator mode unless this is explicitly "false".
VITE_FIREBASE_USE_EMULATORS=true
# Keep this `localhost` (the app's own host): Google sign-in breaks if the emulator is a different site.
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# Optional key for the linkpreview.net API used by the resource URL dialog.
VITE_LINK_PREVIEW_API_KEY=

# Image uploads (the `Upload` component). Optional: "cloudinary" or "firebase". When unset, Cloudinary
# is used if its two values below are set, else Firebase Storage if VITE_FIREBASE_STORAGE_BUCKET is set.
VITE_IMAGE_UPLOAD_PROVIDER=
# Cloudinary unsigned-upload settings (same values as CLOUDINARY_CLOUD_NAME / CLOUDINARY_IMAGE_PRESET in the Flutter .env).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_IMAGE_PRESET=