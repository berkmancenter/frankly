{
  "name": "frankly-client-v3",
  "private": true,
  "version": "0.2.0",
  "description": "Frankly web client built with React, TypeScript, @mui, TanStack Query and XState, backed by (for now) Firebase.",
  "type": "module",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:proxied": "tsc -b && PROXIED=1 vite build",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "dev:proxied": "PROXIED=1 vite",
    "lint": "eslint src",
    "locales:transpile": "node src/locales/flutterTranspile.ts",
    "preview": "vite preview",
    "skill:translate": "command -v claude >/dev/null 2>&1 || { echo 'Warning: Claude CLI is required.' >&2; exit 1; }; claude \"/lingui:find-unwrapped-strings\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@lingui/react": "^6.12.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.106.1",
    "firebase": "^9.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lingui/vite-plugin": "^6.12.0",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.36.0",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
