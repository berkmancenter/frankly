{
  "name": "frankly-client-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Frankly web client built with React, TypeScript, MUI (Material 3), TanStack Query and XState, backed by Firebase.",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:proxied": "PROXIED=1 vite",
    "build": "tsc -b && vite build",
    "build:proxied": "tsc -b && PROXIED=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.106.0",
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.106.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
